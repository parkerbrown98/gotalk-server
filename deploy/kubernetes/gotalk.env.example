# Copy this file or edit it before applying. Kustomize consumes it with secretGenerator.
GOTALK_DATABASE_URL=postgres://gotalk:change-me@postgres.example.com:5432/gotalk?sslmode=require
GOTALK_REDIS_URL=rediss://:change-me@redis.example.com:6380/0
GOTALK_SERVER_PUBLIC_URL=https://forum.example.com
GOTALK_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
GOTALK_STORAGE_S3_ACCESS_KEY_ID=change-me
GOTALK_STORAGE_S3_SECRET_ACCESS_KEY=change-me
GOTALK_SETUP_ADMIN_USERNAME=admin
GOTALK_SETUP_ADMIN_EMAIL=admin@example.com
GOTALK_SETUP_ADMIN_PASSWORD=change-me-please
# Optional managed mail/voice settings:
# GOTALK_MAIL_DRIVER=smtp
# GOTALK_MAIL_FROM=Gotalk <noreply@example.com>
# GOTALK_MAIL_SMTP_HOST=smtp.example.com
# GOTALK_MAIL_SMTP_PORT=587
# GOTALK_MAIL_SMTP_USERNAME=gotalk
# GOTALK_MAIL_SMTP_PASSWORD=change-me
# GOTALK_MAIL_SMTP_TLS=starttls
# GOTALK_VOICE_LIVEKIT_URL=wss://voice.example.com
# GOTALK_VOICE_LIVEKIT_API_URL=https://voice.example.com
# GOTALK_VOICE_LIVEKIT_API_KEY=change-me
# GOTALK_VOICE_LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-0123
