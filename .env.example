# Copy to .env next to docker-compose.yml and adjust. Every GOTALK_* setting can also be
# supplied as GOTALK_<NAME>_FILE pointing at a file (Docker/Kubernetes secrets).

# Strongly recommended outside local testing.
POSTGRES_PASSWORD=change-me
GOTALK_SERVER_PUBLIC_URL=https://forum.example.com

# Host port to expose.
GOTALK_PORT=8080

# text is easier to read in `docker compose logs`; json suits log aggregators.
GOTALK_LOG_FORMAT=text

# Headless setup (optional). When all three are set, setup completes on boot and the
# browser wizard is skipped. Remove them afterwards; they are ignored once set up.
GOTALK_SETUP_ADMIN_USERNAME=
GOTALK_SETUP_ADMIN_EMAIL=
GOTALK_SETUP_ADMIN_PASSWORD=
