# Copy to .env next to docker-compose.yml and adjust. Every GOTALK_* setting can also be
# supplied as GOTALK_<NAME>_FILE pointing at a file (Docker/Kubernetes secrets).

# Strongly recommended outside local testing.
POSTGRES_PASSWORD=change-me
GOTALK_SERVER_PUBLIC_URL=https://forum.example.com

# Host port to expose.
GOTALK_PORT=8080

# text is easier to read in `docker compose logs`; json suits log aggregators.
GOTALK_LOG_FORMAT=text

# Headless setup (optional). When all three are set, setup completes on boot and the
# browser wizard is skipped. Remove them afterwards; they are ignored once set up.
GOTALK_SETUP_ADMIN_USERNAME=
GOTALK_SETUP_ADMIN_EMAIL=
GOTALK_SETUP_ADMIN_PASSWORD=

# Voice (optional). Start the bundled LiveKit server with `docker compose --profile voice up -d`
# and set the URL clients use to reach it. Change the secret (32+ characters) outside local use.
GOTALK_VOICE_LIVEKIT_URL=
LIVEKIT_API_KEY=gotalk
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-0123
# This host's IP as reachable by clients; 127.0.0.1 only works on the same machine.
LIVEKIT_NODE_IP=127.0.0.1

# Webhooks refuse private, loopback and link-local addresses so place managers cannot probe
# your network. Set to true only if every place manager is trusted.
GOTALK_WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false

# Link previews: the server fetches links posted in chat and forum posts (title, description,
# preview image). Like webhooks, it refuses private addresses; allow them only for development.
# GOTALK_EMBEDS_ENABLED=true
GOTALK_EMBEDS_ALLOW_PRIVATE_NETWORKS=false

# Storage and email can also be configured in the browser setup wizard instead. Setting a
# driver here makes that section read-only in the browser.

# File storage for uploads (default: the gotalk-data volume at /data).
# GOTALK_STORAGE_DRIVER=s3
# GOTALK_STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# GOTALK_STORAGE_S3_REGION=auto
# GOTALK_STORAGE_S3_BUCKET=gotalk-media
# GOTALK_STORAGE_S3_ACCESS_KEY_ID=
# GOTALK_STORAGE_S3_SECRET_ACCESS_KEY=
# GOTALK_STORAGE_S3_FORCE_PATH_STYLE=false

# Email (password resets, email verification). For local testing with the bundled Mailpit:
#   docker compose --profile mail up -d   and open http://localhost:8025
# GOTALK_MAIL_DRIVER=smtp
# GOTALK_MAIL_FROM=Gotalk <noreply@localhost>
# GOTALK_MAIL_SMTP_HOST=mailpit
# GOTALK_MAIL_SMTP_PORT=1025
# GOTALK_MAIL_SMTP_TLS=none
# Or an API provider: sendgrid, mailgun (+ GOTALK_MAIL_DOMAIN), postmark, resend, ses.
# GOTALK_MAIL_API_KEY=
